# Copy to .env and fill in. .env is gitignored — never commit it.

# From @BotFather: /newbot -> token looks like 123456789:AAE...
TELEGRAM_BOT_TOKEN=

# Bot username WITHOUT the @, e.g. MyTradingAssistantBot
# Used to build the t.me/<username> pairing link in Phase 2.
TELEGRAM_BOT_USERNAME=

# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Phase 2 (Postgres via docker compose). Unused in Phase 1.
DATABASE_URL=postgresql://trading:trading@localhost:5432/trading_assistant
