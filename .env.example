# Copy to .env and fill in. .env is gitignored — never commit it.

# From @BotFather: /newbot -> token looks like 123456789:AAE...
TELEGRAM_BOT_TOKEN=

# Bot username WITHOUT the @, e.g. MyTradingAssistantBot
# Used to build the t.me/<username> pairing link in Phase 2.
TELEGRAM_BOT_USERNAME=

# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Orchestrator database (docker compose up -d).
DATABASE_URL=postgresql://trading:trading@localhost:5432/trading_assistant


# Orchestrator (apps/orchestrator)
# "anthropic" | "ollama" | "stub"
#   anthropic  the Claude API — needs credits
#   ollama     local models (free, offline) or Ollama Cloud after `ollama signin`
#   stub       no model at all; for testing the plumbing without spend
LLM_PROVIDER=anthropic
ANTHROPIC_MODEL=claude-sonnet-5
MCP_URL=http://127.0.0.1:8081/mcp

# Ollama. A "-cloud" suffix runs on Ollama's GPUs instead of this machine —
# same local endpoint either way, so nothing else changes.
#   local :  qwen3:8b, granite4.1:8b, lfm2.5:8b
#   cloud :  gpt-oss:120b-cloud, qwen3.5:122b-cloud
OLLAMA_MODEL=gpt-oss:120b-cloud   # verified: tool calling, ~6s/turn, free
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Live trader notifications (apps/live_notify). Both optional.
# LIVE_STATUS_UTC=21:30                    # when the daily status is sent
# LIVE_NOTIFY_STATE=~/.local/state/trading-assistant/live-notify.json
