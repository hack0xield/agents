# Groups the three application services so they start, stop and restart as one:
#
#   sudo systemctl restart trading-assistant.target
#
# Deliberately excludes xvfb and mt5-terminal. Those are infrastructure: the
# terminal costs a login and a symbol sync to restart, and bouncing the app
# should not pay for it.
[Unit]
Description=Trading assistant — bridge, tools and orchestrator
Wants=mt5-bridge.service mcp-server.service orchestrator.service

[Install]
WantedBy=multi-user.target
