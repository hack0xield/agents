# The terminal is kept running rather than launched on demand. mt5.initialize()
# attaches to a live terminal in 5-7 ms but hangs indefinitely when it has to
# launch one itself — the terminal starts fine, the client just never completes
# its handshake with the instance it spawned. docs/MT5.md already noted that
# terminal and connection lifetimes are independent; headless makes that the
# required design rather than a nice property.
[Unit]
Description=MetaTrader 5 terminal under Wine (kept warm for the MT5 bridge)
After=network-online.target xvfb.service
Wants=xvfb.service

[Service]
# Type=forking, because wine is a launcher and not the process. Once MT5 has
# applied a LiveUpdate it re-execs itself as
#   terminal64.exe /skipupdate:<token> /portable
# and the wine that started it exits 0 after ~2 s. Under the default
# Type=simple systemd reads that exit as the service dying, kills the cgroup,
# and restarts forever — while the terminal it was meant to supervise is
# running perfectly the whole time. Only visible after the first LiveUpdate,
# which is why a fresh install looks fine.
Type=forking
EnvironmentFile=-%h/.config/trading-assistant/env
WorkingDirectory=%h
ExecStart=/usr/bin/wine "C:\\Program Files\\MetaTrader 5\\terminal64.exe"
# Tolerant: wineserver -k exits non-zero when there is nothing left to kill,
# which would otherwise mark a clean stop as failed.
ExecStop=-/usr/bin/wineserver -k
Restart=always
RestartSec=15
TimeoutStartSec=120
TimeoutStopSec=30

[Install]
WantedBy=default.target
