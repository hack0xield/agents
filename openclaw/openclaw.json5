// Versioned copy of the OpenClaw gateway config.
// Installed to ~/.openclaw/openclaw.json by scripts/install-config.sh
//
// NOTHING SECRET GOES IN THIS FILE. The bot token and Anthropic key are read
// from the environment (see .env.example) — spec.txt §47.
//
// Schema verified against OpenClaw 2026.7.1-2 via `openclaw config schema`.

{
  // `openclaw onboard` normally writes this. We hand-write the config instead,
  // and the gateway refuses to start without gateway.mode — it treats a config
  // missing it as possibly clobbered. Verified via `openclaw config schema`.
  // Stub trading tools: read-only, fixture-backed, spec.txt §10/§11.
  // Served by mcp_server/server.py — run it with scripts/mcp-server.sh before
  // the gateway, or tool calls fail at request time rather than at startup.
  //
  // OpenClaw rewrites dotted tool names to be provider-safe, so `mt5.get_account`
  // reaches the model as `trading__mt5-get_account`. agent-workspace/TOOLS.md
  // documents the mapping; the model needs the name it can actually call.
  //
  // MCP is the request/response tool interface only. It is deliberately not the
  // transport for real-time market data (§11) — that stays on normal
  // application infrastructure.
  mcp: {
    servers: {
      trading: {
        url: "http://127.0.0.1:8081/mcp",
        transport: "streamable-http",
      },
    },
  },

  gateway: {
    mode: "local",      // channels + agent runtime run on this host
    bind: "loopback",   // POC: do not expose the control plane to the LAN

    // NOTE: this does NOT keep other local processes out. OpenClaw auto-approves
    // device pairing for direct loopback connects, so anything running as this
    // user can drive the gateway regardless of the token — verified: the CLI
    // works with OPENCLAW_GATEWAY_TOKEN unset. The token is what protects
    // non-loopback clients, so it is set now and matters the moment `bind`
    // stops being "loopback". Treat this box as the trust boundary until then.
    // The token itself lives in .env, never in this file.
    auth: {
      mode: "token",
      token: { source: "env", provider: "default", id: "OPENCLAW_GATEWAY_TOKEN" },
    },
  },

  channels: {
    telegram: {
      enabled: true,

      // "pairing": an unknown DM must be approved by the operator before the
      // agent will answer. Phase 2 automates the approval side against our own
      // pairing tokens. Never relax this to "open" — that lets any Telegram
      // account on earth talk to the agent and spend our tokens.
      dmPolicy: "pairing",

      // DM-only POC. No group support.
      groups: {},
    },
  },

  agents: {
    // ─────────────────────────────────────────────────────────────────────
    // TEMPORARY: running on the founder's personal Claude subscription.
    //
    // 2026-08-19. The Anthropic API key authenticates (HTTP 200 on
    // /v1/models) but has a zero credit balance, so every /v1/messages call
    // is rejected — confirmed by curl against Sonnet 5 AND Haiku 4.5, so it
    // is an account-level balance, not a model-tier limit. There is no free
    // allowance on the API.
    //
    // Rather than block the POC on a purchase, the agent runs through the
    // `claude-cli` provider, which shells out to the locally authenticated
    // Claude Code CLI and bills against the founder's own subscription.
    //
    // THIS IS NOT A PRODUCTION PATH. It is viable only while the founder is
    // the sole user:
    //   - a personal subscription is not a licence to serve other people;
    //   - there is no per-user token accounting, so spec.txt §52's
    //     "LLM cost per paying user" cannot be measured;
    //   - it depends on a CLI binary inside a Cursor extension directory
    //     (see scripts/link-claude-cli.sh), which is not deployable.
    //
    // TO SWAP BACK — buy API credits, then change the two model lines below
    // from `claude-cli/claude-sonnet-5` to `anthropic/claude-sonnet-5` and
    // re-run scripts/install-config.sh. Nothing else depends on this choice;
    // that is why the provider prefix is the only thing that changes.
    //
    // This must be resolved before Phase 5 (cost logging) and before anyone
    // other than the founder is connected, whichever comes first.
    // ─────────────────────────────────────────────────────────────────────
    defaults: {
      model: "claude-cli/claude-sonnet-5",

      // The only claude binary here lives inside the Cursor extension, at a
      // versioned path that changes on every update. scripts/link-claude-cli.sh
      // re-resolves it and symlinks ~/.local/bin/claude, so this stays "claude".
      cliBackends: {
        "claude-cli": {
          command: "claude",
        },
      },
    },

    list: [
      {
        id: "trading-assistant",
        name: "Trading Assistant",
        default: true,
        workspace: "~/.openclaw/workspace-trading",

        identity: {
          name: "Trading Assistant",
          emoji: "📈",
        },

        // spec.txt §8: Sonnet is the normal brain; the expensive model is the
        // exception, not the default. Provider prefix is claude-cli rather than
        // anthropic only because of the credit-balance situation documented
        // above — the model itself is unchanged.
        model: "claude-cli/claude-sonnet-5",

        // spec.txt §49: the assistant must not run shell commands, touch the
        // filesystem, or browse arbitrary URLs. OpenClaw ships these enabled,
        // so they are denied here BEFORE the bot is reachable from Telegram.
        //
        // Profile "messaging" rather than "minimal" because MCP tools are only
        // surfaced in the coding/messaging profiles, and Phase 4 adds our
        // mt5.* / backtests.* MCP server.
        tools: {
          profile: "messaging",
          deny: [
            "exec",
            "process",
            "write",
            "edit",
            "apply_patch",
            "browser",
            "sessions_spawn",
            "subagents",
          ],
        },

        sandbox: {
          mode: "off",
          workspaceAccess: "none",
        },

        // Semantic recall defaults to an OpenAI embedding provider. We have no
        // OpenAI key and do not want that dependency: spec.txt §27 wants
        // structured truth in SQL anyway, and vector recall only for long-form
        // notes. Revisit in the memory phase, on a provider we control.
        memorySearch: {
          enabled: false,
        },
      },
    ],
  },
}
